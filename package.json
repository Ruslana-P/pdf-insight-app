{
  "name": "pdf-insight-app",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "format:check": "npm run format:check --prefix frontend && npm run format:check --prefix backend",
    "test": "npm run test --prefix frontend && npm run test --prefix backend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm exec --prefix frontend -- prettier --write",
      "npm exec --prefix frontend -- eslint --fix --max-warnings=0"
    ],
    "frontend/**/*.{json,md,css,html}": [
      "npm exec --prefix frontend -- prettier --write"
    ],
    "backend/**/*.ts": [
      "npm exec --prefix backend -- prettier --write",
      "npm exec --prefix backend -- eslint --fix --max-warnings=0"
    ],
    "backend/**/*.{json,md}": [
      "npm exec --prefix backend -- prettier --write"
    ]
  }
}
